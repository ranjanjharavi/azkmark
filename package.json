{
  "name": "azkmark",
  "version": "1.0.0",
  "description": "Personal bookmark manager",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.cjs && tsc --project tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "jsdom": "30.1.2",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "dependencies": {
    "dompurify": "3.4.17",
    "lucide": "1.55.0",
    "marked": "18.1.1",
    "prettier": "3.9.10"
  }
}
